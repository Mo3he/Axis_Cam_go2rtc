{
  "app": "go2rtc",
  "friendlyName": "go2rtc",
  "versionPolicy": "mirror",
  "upstream": {
    "type": "github-release",
    "repo": "AlexxIT/go2rtc",
    "stripV": true,
    "name": "go2rtc",
    "changesUrl": "https://github.com/AlexxIT/go2rtc/releases/tag/v${UPSTREAM}"
  },
  "build": {
    "command": "./build.sh",
    "env": {
      "GO2RTC_VERSION": "v${VERSION}"
    }
  },
  "pins": [
    {
      "file": "Dockerfile",
      "arg": "GO2RTC_VERSION",
      "prefix": "v"
    }
  ],
  "forks": [
    {
      "note": "HKSV variant: the fork adds HomeKit Secure Video. Its release-arm.yml normally builds hksv-latest; acap-build.sh does the same locally.",
      "repo": "Mo3he/go2rtc",
      "branch": "hksv",
      "upstream": "AlexxIT/go2rtc",
      "upstreamTag": "v${UPSTREAM}",
      "release": "hksv-latest",
      "test": "go test ./...",
      "build": "go build -trimpath -ldflags='-s -w' -o \"$ASSET\" .",
      "assets": [
        {
          "name": "go2rtc_linux_arm64",
          "env": { "GOOS": "linux", "GOARCH": "arm64", "CGO_ENABLED": "0" }
        },
        {
          "name": "go2rtc_linux_arm",
          "env": { "GOOS": "linux", "GOARCH": "arm", "GOARM": "7", "CGO_ENABLED": "0" }
        }
      ]
    }
  ],
  "signing": {
    "skip": [
      "*_acap3.eap",
      "*_root.eap"
    ]
  }
}
